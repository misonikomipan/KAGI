# Copy to .env for `bun run probe`. Never commit .env.

# SESAME (needs Hub3 or Wi-Fi Module 2)
SESAME_API_KEY=
SESAME_UUID=
# 16-byte device secret key as 32 hex chars
SESAME_SECRET_KEY=

# SwitchBot (app: Profile > Preferences > Developer Options)
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
# `bun run probe switchbot devices` lists device ids
SWITCHBOT_DEVICE_ID=

# Name recorded in the SESAME app history
KAGI_PROBE_NAME=KAGI probe
