# Copy to .env for local runs (`bun run probe`, `bun run dev`). Never commit .env.
# On Cloud Run, set the same names as env vars / Secret Manager secrets.

# ---- Lock vendors (set the ones you use) -----------------------------------

# SESAME (needs Hub3 or Wi-Fi Module 2). API key: https://biz.candyhouse.co/biz/developer
SESAME_API_KEY=
# Used by `bun run probe` only; the server reads devices from KAGI_DOORS.
SESAME_UUID=
SESAME_SECRET_KEY=

# SwitchBot (app: Profile > Preferences > Developer Options)
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
# Used by `bun run probe` only. `bun run probe switchbot devices` lists ids.
SWITCHBOT_DEVICE_ID=

# Name recorded in the SESAME app history by `bun run probe`
KAGI_PROBE_NAME=KAGI probe

# ---- Server (`bun run dev`) ------------------------------------------------

# The URL people reach (and that is written on the NFC tags), without a path.
KAGI_PUBLIC_ORIGIN=http://localhost:8080
# Doors as a JSON array. "driver" is "sesame" or "switchbot".
KAGI_DOORS='[{"id":"home","name":"Home","driver":"sesame","device":{"uuid":"<SESAME UUID>","secretKey":"<32 hex chars>"}}]'
# en | ja
KAGI_LANG=ja

# ---- Sign-in: oidc (default) | clerk ----------------------------------------
KAGI_AUTH=oidc

# Any OpenID Connect provider (Pocket ID, Google, Entra ID, Okta, Keycloak, …).
# Register the redirect URI <KAGI_PUBLIC_ORIGIN>/auth/callback at the provider.
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only)
OIDC_CLIENT_SECRET=
# Pocket ID: include "groups" to receive group membership
OIDC_SCOPES=openid profile email groups
# 32+ random chars; encrypts KAGI's session cookie. Rotating it signs everyone out.
# Generate: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
KAGI_SESSION_SECRET=
# How long a sign-in lasts at KAGI (default 43200 = 12 h)
# KAGI_SESSION_TTL_SECONDS=43200

# KAGI_AUTH=clerk instead (Clerk dashboard > API keys)
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# ---- Who may open which door ------------------------------------------------
# A list claim containing <prefix><door id> (or <prefix>*).
# Defaults: oidc -> claim "groups", prefix "door:" (Pocket ID group "door:home")
#           clerk -> claim "publicMetadata.doors", no prefix
# KAGI_ALLOW_CLAIM=groups
# KAGI_ALLOW_PREFIX=door:
# Optional extra check: POST {principal, door, now} -> {allow, reason?}
# KAGI_AUTHORIZER_URL=
# KAGI_AUTHORIZER_TOKEN=

# ---- Optional API for other apps: POST /api/doors/:id/unlock ---------------
# Callers send "Authorization: Bearer <JWT>" signed by this issuer (e.g. HCM forwarding
# the user's Clerk session token). Unset = no API route.
# KAGI_API_JWT_ISSUER=https://clerk.example.com
# KAGI_API_JWT_JWKS_URL=           # default: from the issuer's discovery document
# KAGI_API_JWT_AUDIENCE=
# KAGI_API_JWT_AUTHORIZED_PARTIES=https://hcm.example.com
